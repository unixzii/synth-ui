{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // Inside the workspace, @synth-ui/* resolve to each other's sources, so
    // nothing has to be built first. Builds clear this and use dist/.
    "customConditions": ["@synth-ui/source"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true
  }
}
