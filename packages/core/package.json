{
  "name": "@synth-ui/core",
  "version": "0.1.0",
  "description": "Foundation of synth-ui's immediate-mode UI APIs",
  "author": "Cyandev <unixzii@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unixzii/synth-ui.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/unixzii/synth-ui#readme",
  "bugs": "https://github.com/unixzii/synth-ui/issues",
  "keywords": [
    "ui",
    "immediate-mode",
    "pixel-art",
    "retro",
    "gui"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@synth-ui/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./backend": {
      "@synth-ui/source": "./src/backend.ts",
      "types": "./dist/backend.d.ts",
      "default": "./dist/backend.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepack": "pnpm clean && pnpm build"
  }
}
